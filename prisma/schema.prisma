generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  employeeCode  String    @unique
  name          String
  displayName   String
  role          String
  email         String    @unique
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?
  scope             String?
  status            String   @default("active")
  connectedAt       DateTime @default(now())
  lastUsedAt        DateTime?

  @@unique([provider, providerAccountId])
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  service   String
  action    String
  detail    String?
  timestamp DateTime @default(now())
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  expires      DateTime
}

